# WPGraphQL endpoint on your WordPress install (install the "WPGraphQL" plugin,
# then add "WPGraphQL for WPML" or "WPGraphQL Polylang" if you use one of
# those for the AR/FR/RU/ES/CN translations).
NEXT_PUBLIC_WORDPRESS_API_URL=https://af.net/graphql

# Hostname WordPress serves media from — used to allow next/image to
# optimize images pulled from /wp-content/uploads/.
NEXT_PUBLIC_WORDPRESS_HOSTNAME=af.net
