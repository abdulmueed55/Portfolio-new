# af.net's existing REST API base (the one already set up in
# kadence-child/rest-api-config.php for the React Native app — CORS is
# already open on it, so no new WordPress plugin is required).
NEXT_PUBLIC_WORDPRESS_API_URL=https://af.net/wp-json

# Hostname WordPress serves media from — used to allow next/image to
# optimize images pulled from /wp-content/uploads/.
NEXT_PUBLIC_WORDPRESS_HOSTNAME=af.net
